# Copy this file to .env.local and fill in real values.
# See README.md "Connecting to Vercel" for where each of these comes from.

# Postgres connection string (Vercel/Neon integration -> pooled connection string).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js session encryption secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Anthropic API key powering every coaching feature.
ANTHROPIC_API_KEY=

# Stripe (test mode keys while developing).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STUDENT_PRO=
STRIPE_PRICE_SCHOOL=
STRIPE_PRICE_COMPETITION=

# Base URL used to build Stripe success/cancel redirect links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
