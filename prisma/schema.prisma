// SpeakUp AI — database schema
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  STUDENT_PRO
  SCHOOL
  COMPETITION_PREP
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

// ── Auth.js ──────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String?
  emailVerified DateTime?
  image         String?

  plan             Plan    @default(FREE)
  stripeCustomerId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  onboarding       OnboardingProfile?
  debateProgress   DebateProgress?
  speakingProgress SpeakingProgress?
  subscription     Subscription?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Onboarding ───────────────────────────────────────────────────────────────

model OnboardingProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // survey answers
  experience String
  focus      String[]
  goal       String

  // AI-generated profile (matches OnboardingProfile in src/lib/types.ts)
  greeting                  String
  tagline                   String
  recommendedStart          String
  topFocusSkills            String[]
  weeklyGoal                String
  coachingStyle             String
  difficultyLevel           String
  personalizedInsights      String[]
  firstChallengeTitle       String
  firstChallengeDescription String

  createdAt DateTime @default(now())
}

// ── Debate progress ──────────────────────────────────────────────────────────

model DebateProgress {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  level Int @default(1)
  xp    Int @default(0)

  weaknesses Json @default("{}")

  sessions  DebateSessionRecord[]
  updatedAt DateTime               @updatedAt
}

model DebateSessionRecord {
  id         String         @id @default(cuid())
  progressId String
  progress   DebateProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  type       String
  level      Int
  topic      String
  score      Int
  weaknesses String[]
  date       DateTime @default(now())
}

// ── Speaking progress ────────────────────────────────────────────────────────

model SpeakingProgress {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  level Int @default(1)
  xp    Int @default(0)

  weaknesses Json @default("{}")

  sessions  SpeakingSessionRecord[]
  updatedAt DateTime                @updatedAt
}

model SpeakingSessionRecord {
  id         String           @id @default(cuid())
  progressId String
  progress   SpeakingProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  type       String
  level      Int
  topic      String
  score      Int
  weaknesses String[]
  date       DateTime @default(now())
}

// ── Billing ──────────────────────────────────────────────────────────────────

model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
